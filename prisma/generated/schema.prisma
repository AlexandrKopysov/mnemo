datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../prisma/generated"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  login        String   @unique
  email        String?  @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
}
